#这是一个庞大的检测物品栏是否有ui物品的函数
#所有的函数都会运行一个指令：
#   function tess:slot/modify\
#   with entity @n[tag=tess.temp.update_slot,limit=1]\
#   item.components."minecraft:custom_data".tess.comp_data
#其中 @n[tag=tess.temp.update_slot,limit=1] 指向那个ui物品
execute if items entity @s container.0 *[custom_data~{tess:{comp_data:{loaded:true}}}] run return run function tess:slot/modify/0
